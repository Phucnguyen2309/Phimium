# Gọi API cùng domain để cookie đăng nhập (HttpOnly) là first-party:
# - Dev: Vite proxy /api -> VITE_DEV_API_TARGET (mặc định http://localhost:8080)
# - Vercel: vercel.json rewrite /api -> Backend trên Render
VITE_API_BASE_URL=/api
# VITE_DEV_API_TARGET=http://localhost:8080

# Google OAuth Client ID (giống GOOGLE_CLIENT_ID của Backend)
VITE_GOOGLE_CLIENT_ID=

# (Tuỳ chọn) Tile bản đồ khác OpenStreetMap, VD MapTiler có key
# VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_CARTO_KEY
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
