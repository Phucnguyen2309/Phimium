# URL gốc của Backend API (có /api)
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth Client ID (giống GOOGLE_CLIENT_ID của Backend)
VITE_GOOGLE_CLIENT_ID=

# (Tuỳ chọn) Tile bản đồ khác OpenStreetMap, VD MapTiler có key
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
