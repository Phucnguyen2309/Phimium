{
  "info": {
    "name": "PHIMIUM Backend Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "googleCredential",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "onboardingToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Local register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"abc@gmail.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Nguyen Van A\",\n  \"birthday\": \"2002-05-10\",\n  \"phone\": \"0912345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/verify-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"abc@gmail.com\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Resend OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/resend-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"abc@gmail.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Local login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"abc@gmail.com\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Google signup / login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/google",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credential\": \"{{googleCredential}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Complete Google profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{onboardingToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/complete-profile",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"birthday\": \"2002-05-10\",\n  \"phone\": \"0987654321\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Link Google to current account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/link/google",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credential\": \"{{googleCredential}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data || {};",
              "  ['accessToken', 'refreshToken', 'onboardingToken'].forEach(key => {",
              "    if (data[key]) pm.collectionVariables.set(key, data[key]);",
              "  });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}