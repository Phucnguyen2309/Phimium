
name: Deploy PHIMIUM Backend

on:
  push:
    branches: [main]
    paths:
      - "BE/**"
      - ".github/workflows/deploy-backend.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: phimium-backend-production
  cancel-in-progress: false

jobs:
  ci:
    name: Build and Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven
          cache-dependency-path: BE/pom.xml

      - name: Maven verify
        working-directory: BE
        run: mvn -B verify

  deploy:
    name: Deploy to VPS
    needs: ci
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Configure SSH
        env:
          SSH_KEY: ${{ secrets.VPS_SSH_KEY }}
          KNOWN_HOSTS: ${{ secrets.VPS_KNOWN_HOSTS }}
        run: |
          mkdir -p ~/.ssh
          chmod 700 ~/.ssh
          printf '%s\n' "$SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts

      - name: Deploy backend
        run: |
          ssh -i ~/.ssh/id_ed25519 \
            -o StrictHostKeyChecking=yes \
            -o BatchMode=yes \
            -p 26266 \
            deploy@103.162.30.48 'bash -se' <<'REMOTE'
          set -e

          cd /opt/phimium/source
          git pull --ff-only origin main

          cd /opt/phimium
          sudo -n /usr/bin/docker compose up -d --build --no-deps backend

          sudo -n /usr/bin/docker compose ps backend
          REMOTE
